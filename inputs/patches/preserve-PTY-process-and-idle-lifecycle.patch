+        currentPid: 999,
+        readProcessTable: () => TABLE,
+        readDescendantTable,
+        signalProcessGroup
+      })
+
+      expect(readDescendantTable).not.toHaveBeenCalled()
+      expect(signalProcessGroup.mock.calls.map(([pgid]) => pgid)).toEqual([101, 103, 100])
+    })
+  })
