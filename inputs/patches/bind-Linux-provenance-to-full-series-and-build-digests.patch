+function readRequiredDigest(name) {
+  const value = process.env[name]
+  if (typeof value !== 'string' || value.length !== 64 || !/^[0-9a-f]{64}$/.test(value)) {
+    throw new Error(`${name} must be 64 lowercase hex characters`)
+  }
+  return value
+}
