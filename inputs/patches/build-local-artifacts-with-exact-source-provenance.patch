diff --git a/config/scripts/build-provenance.cjs b/config/scripts/build-provenance.cjs
new file mode 100644
index 0000000000000000000000000000000000000000..22bae3c00bf7dd3e43ad1ce2d126b8dbefa86a86
--- /dev/null
+++ b/config/scripts/build-provenance.cjs
@@ -0,0 +1,38 @@
+const { execFileSync } = require('node:child_process')
+const { writeFileSync } = require('node:fs')
+const { join, resolve } = require('node:path')
+const { writeMacBuildCompatibility } = require('./mac-build-compatibility.cjs')
+
+const WORKBENCH_ROOT = resolve(__dirname, '../..')
+
+function readWorkbenchCommit(cwd = WORKBENCH_ROOT) {
+  const commit = execFileSync('git', ['rev-parse', '--verify', 'HEAD^{commit}'], {
+    cwd,
+    encoding: 'utf8'
+  }).trim()
+  if (!/^(?:[0-9a-f]{40}|[0-9a-f]{64})$/.test(commit)) {
+    throw new Error(`Git returned an invalid full commit identity: ${commit}`)
+  }
+  return commit
+}
+
+function writeBuildProvenance(
+  resourcesDir,
+  { platform, version, architecture },
+  cwd = WORKBENCH_ROOT
+) {
+  const commit = readWorkbenchCommit(cwd)
+  if (platform === 'darwin') {
+    writeMacBuildCompatibility(resourcesDir, { version, commit, architecture })
+  } else if (platform === 'linux') {
+    writeFileSync(
+      join(resourcesDir, 'orca-fork-build.json'),
+      `${JSON.stringify({ version, commit, platform, architecture }, null, 2)}\n`,
+      'utf8'
+    )
+  } else {
+    throw new Error(`Unsupported build provenance platform: ${platform}`)
+  }
+}
+
+module.exports = { readWorkbenchCommit, writeBuildProvenance }
diff --git a/config/scripts/build-provenance.test.mjs b/config/scripts/build-provenance.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..c2c6bec733e5ead684568d21781f4eec54c0bf30
--- /dev/null
+++ b/config/scripts/build-provenance.test.mjs
@@ -0,0 +1,90 @@
+import { execFileSync } from 'node:child_process'
+import { mkdtempSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { describe, expect, it } from 'vitest'
+import { getLocalBuildIdentity } from './build-mac-local.mjs'
+import provenance from './build-provenance.cjs'
+
+const { readWorkbenchCommit, writeBuildProvenance } = provenance
+
+function withWorkbench(check) {
+  const root = mkdtempSync(join(tmpdir(), 'orca-build-provenance-'))
+  const cwd = join(root, 'workbench')
+  const home = join(root, 'home')
+  mkdirSync(cwd)
+  mkdirSync(home)
+  const git = (...args) => execFileSync('git', args, {
+    cwd,
+    encoding: 'utf8',
+    env: {
+      ...process.env,
+      HOME: home,
+      GIT_CONFIG_GLOBAL: '/dev/null',
+      GIT_CONFIG_SYSTEM: '/dev/null',
+      GIT_AUTHOR_NAME: 'Build fixture',
+      GIT_AUTHOR_EMAIL: 'build@example.invalid',
+      GIT_COMMITTER_NAME: 'Build fixture',
+      GIT_COMMITTER_EMAIL: 'build@example.invalid',
+      GIT_AUTHOR_DATE: '2026-01-01T00:00:00Z',
+      GIT_COMMITTER_DATE: '2026-01-01T00:00:00Z'
+    }
+  }).trim()
+  try {
+    git('init', '--quiet')
+    writeFileSync(join(cwd, 'package.json'), JSON.stringify({ version: '1.4.215' }))
+    git('add', 'package.json')
+    git('commit', '--quiet', '-m', 'upstream')
+    check({ cwd, root, git })
+  } finally {
+    rmSync(root, { recursive: true, force: true })
+  }
+}
+
+describe('workbench build provenance', () => {
+  it('stamps both packages with the full current workbench HEAD, not the upstream commit', () => {
+    withWorkbench(({ cwd, root, git }) => {
+      const upstream = git('rev-parse', 'HEAD')
+      git('commit', '--quiet', '--allow-empty', '-m', 'fork concern')
+      const head = git('rev-parse', 'HEAD')
+      expect(head).not.toBe(upstream)
+      expect(readWorkbenchCommit(cwd)).toBe(head)
+      const oldBuildCommit = process.env.ORCA_BUILD_COMMIT
+      const oldGithubSha = process.env.GITHUB_SHA
+      process.env.ORCA_BUILD_COMMIT = upstream
+      process.env.GITHUB_SHA = upstream
+      try {
+        const identity = getLocalBuildIdentity({ cwd, timestamp: 123456 })
+        expect(identity.commit).toBe(head)
+        expect(identity.version).toBe(`1.4.215-local.123456.${head.slice(0, 12)}`)
+        for (const [platform, architecture, filename] of [
+          ['darwin', 'arm64', 'orca-local-build.json'],
+          ['linux', 'x64', 'orca-fork-build.json']
+        ]) {
+          const resources = join(root, platform, 'resources')
+          mkdirSync(resources, { recursive: true })
+          writeBuildProvenance(resources, { platform, architecture, version: identity.version }, cwd)
+          const stamp = JSON.parse(readFileSync(join(resources, filename), 'utf8'))
+          expect(stamp.commit).toBe(head)
+          expect(stamp.platform).toBe(platform)
+          expect(stamp.architecture).toBe(architecture)
+          expect(stamp.version).toBe(identity.version)
+        }
+      } finally {
+        if (oldBuildCommit === undefined) delete process.env.ORCA_BUILD_COMMIT
+        else process.env.ORCA_BUILD_COMMIT = oldBuildCommit
+        if (oldGithubSha === undefined) delete process.env.GITHUB_SHA
+        else process.env.GITHUB_SHA = oldGithubSha
+      }
+    })
+  })
+
+  it('refuses a repository without a committed HEAD instead of inventing an identity', () => {
+    withWorkbench(({ root, git }) => {
+      const unborn = join(root, 'unborn')
+      mkdirSync(unborn)
+      git('init', '--quiet', unborn)
+      expect(() => readWorkbenchCommit(unborn)).toThrow()
+    })
+  })
+})
