+++ b/src/main/runtime/orchestration/db/worker-terminal/failed-start-dispatch-identity.ts
@@ -3,11 +3,15 @@ import type { OrchestrationDb } from '../orchestration-db'
 import { structuredWorkerOrcaSessionIdForIncarnation } from '../../../structured-worker-identity'
 
 /**
- * A start that dies before `prepareStartingWorkerAuthority` never filled the Dispatch context in,
- * and release re-proves identity through it — so the custody row written at terminal creation would
+ * A start that dies before its authority is bound never filled the Dispatch context in, and
+ * release re-proves identity through it — so the custody row written at terminal creation would
