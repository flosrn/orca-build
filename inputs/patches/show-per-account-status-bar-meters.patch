+// @vitest-environment happy-dom
+/**
+ * StatusBar is a memo boundary and locale catalogs load lazily, so a language switch can land
+ * with no store change at all. The bar must still repaint its translated copy.
+ */
+import { act, type ReactNode } from 'react'
+import { createRoot, type Root } from 'react-dom/client'
