+import { AlertTriangle } from 'lucide-react'
+import React from 'react'
+import type { ProviderRateLimits } from '../../../../shared/rate-limit-types'
+import { ProviderIcon } from './tooltip'
+import type { UsageAccountBadge } from './usage-account-segments'
+
+/** A failing lane's warning mark; given a reason, it names it on hover where no label does. */
+export function RefreshFailingMark({ reason }: { reason: string | null }): React.JSX.Element {
+  const icon = <AlertTriangle size={11} className="shrink-0 text-muted-foreground/80" />
+  if (reason === null) {
+    return icon
+  }
+  return (
+    <span role="img" aria-label={reason} title={reason} className="inline-flex shrink-0">
+      {icon}
+    </span>
+  )
+}
+
+export function ProviderAccountMark({
+  provider,
+  badge
+}: {
+  provider: ProviderRateLimits['provider']
+  badge: UsageAccountBadge | null
+}): React.JSX.Element {
+  if (!badge) {
+    return <ProviderIcon provider={provider} />
+  }
+  return (
+    <span
+      className="inline-flex items-center gap-1"
+      title={badge.email ?? undefined}
+      aria-label={badge.email ?? `${provider} ${badge.ordinal}`}
+    >
+      <ProviderIcon provider={provider} />
+      <span
+        className={
+          badge.isActive
+            ? 'text-[10px] font-semibold leading-none tabular-nums text-foreground/90'
+            : 'text-[10px] font-medium leading-none tabular-nums text-muted-foreground/60'
+        }
+      >
+        {badge.ordinal}
+      </span>
+    </span>
+  )
+}
