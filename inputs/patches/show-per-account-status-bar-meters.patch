+import { i18n } from '@/i18n/i18n'
+import type * as StoreSelectors from '../../store/selectors'
+
+const mocks = vi.hoisted(() => ({ state: {} as Record<string, unknown> }))
+
+vi.mock('../../store', () => {
+  const useAppStore = (selector: (state: Record<string, unknown>) => unknown): unknown =>
+    selector(mocks.state)
+  useAppStore.getState = () => mocks.state
+  return { useAppStore }
+})
+
+vi.mock('../../store/selectors', async (importOriginal) => ({
+  ...(await importOriginal<typeof StoreSelectors>()),
+  selectFloatingWorkspaceHasUnread: () => false
+}))
+
+vi.mock('@/hooks/useShortcutLabel', () => ({
+  useShortcutLabel: () => ''
+}))
+
+vi.mock('@/lib/agent-catalog', () => ({
+  AgentIcon: () => null
+}))
+
+// Segments on the right of the bar read their own store slices; they are not under test here.
+vi.mock('./CaffeinateStatusSegment', () => ({ CaffeinateStatusSegment: () => null }))
+vi.mock('./RemoteServerUpdateStatusSegment', () => ({
+  RemoteServerUpdateStatusSegment: () => null
+}))
+vi.mock('./SkillUpdateStatusSegment', () => ({ SkillUpdateStatusSegment: () => null }))
+vi.mock('./NativeChatResumeStatusSegment', () => ({ NativeChatResumeStatusSegment: () => null }))
+vi.mock('./UpdateStatusSegment', () => ({ UpdateStatusSegment: () => null }))
+vi.mock('./StatusBarVisibilityMenu', () => ({ StatusBarVisibilityMenu: () => null }))
+vi.mock('./UsagePercentageDisplayChangeNotice', () => ({
+  UsagePercentageDisplayChangeNotice: ({ children }: { children: ReactNode }) => <>{children}</>
+}))
+
+import { StatusBar } from './StatusBar'
+
+function deferredClaude(): ProviderRateLimits {
+  return {
+    provider: 'claude',
+    session: null,
+    weekly: null,
+    updatedAt: 1,
+    error: 'Usage refresh deferred by a live Claude session',
+    status: 'error',
+    usageMetadata: { failureKind: 'deferred-by-live-session' }
+  }
+}
+
+function seedDeferredClaudeLane(): void {
+  mocks.state = {
+    settings: getDefaultSettings('/tmp'),
+    rateLimits: createEmptyRateLimitState({ claude: deferredClaude() }),
+    refreshRateLimits: vi.fn(),
+    refreshDetectedAgents: vi.fn(),
+    ensureDetectedAgents: vi.fn(async () => {}),
+    openSettingsTarget: vi.fn(),
+    openSettingsPage: vi.fn(),
+    recordFeatureInteraction: vi.fn(),
+    setStatusBarUsageMode: vi.fn(),
+    toggleStatusBarItem: vi.fn(),
+    usagePercentageDisplay: 'used',
+    statusBarUsageMode: 'verbose',
+    statusBarVisible: true,
+    statusBarItems: ['claude'],
+    detectedAgentIds: ['claude'],
+    usageEmptyStateDismissed: false
+  }
+}
+
+const mountedRoots: Root[] = []
+
+async function renderStatusBar(): Promise<HTMLDivElement> {
+  const container = document.createElement('div')
+  document.body.appendChild(container)
+  const root = createRoot(container)
+  mountedRoots.push(root)
+  await act(async () => {
+    root.render(
+      <TooltipProvider>
+        <StatusBar floatingTerminalOpen={false} />
+      </TooltipProvider>
+    )
+  })
+  return container
+}
+
+describe('status bar after a UI-language switch', () => {
+  beforeEach(async () => {
+    globalThis.IS_REACT_ACT_ENVIRONMENT = true
+    // Why: happy-dom lays out nothing, and under 500px every lane collapses to a letter badge.
+    vi.spyOn(HTMLElement.prototype, 'getBoundingClientRect').mockReturnValue(
+      new DOMRect(0, 0, 1568, 24)
+    )
+    await i18n.changeLanguage('en')
+    seedDeferredClaudeLane()
+  })
+
+  afterEach(async () => {
+    await act(async () => {
+      for (const root of mountedRoots.splice(0)) {
+        root.unmount()
+      }
+    })
+    document.body.replaceChildren()
+    vi.restoreAllMocks()
+    await i18n.changeLanguage('en')
+  })
+
+  it('renames the usage trigger and relabels its lanes once the new catalog loads', async () => {
+    const container = await renderStatusBar()
+    const englishTrigger = within(container).getByRole('button', { name: 'Usage' })
+    expect(englishTrigger.querySelector('[title="Waiting for credential refresh"]')).not.toBeNull()
+
+    await act(async () => {
+      await i18n.changeLanguage('fr')
+    })
+
+    const frenchTrigger = within(container).getByRole('button', { name: 'Utilisation' })
+    expect(
+      frenchTrigger.querySelector('[title="En attente du renouvellement des identifiants"]')
+    ).not.toBeNull()
+  })
+})
