+// @vitest-environment happy-dom
+/**
+ * Upstream's measured density drops a failing lane's label (compact) or the whole lane (into "+N")
+ * when the bar is short of room. Whatever the level, the lane stays marked and its reason stays
+ * one hover away.
+ */
+import { renderToStaticMarkup } from 'react-dom/server'
+import { describe, expect, it, vi } from 'vitest'
+import type { ProviderRateLimits } from '../../../../shared/rate-limit-types'
+
+vi.mock('@/i18n/i18n', () => ({
+  translate: (_key: string, fallback: string, values: Record<string, string> = {}) =>
+    Object.entries(values).reduce(
+      (text, [key, value]) => text.replace(`{{${key}}}`, value),
+      fallback
+    )
+}))
+vi.mock('@/lib/agent-catalog', () => ({ AgentIcon: () => null }))
+vi.mock('@/hooks/useResetCountdownClock', () => ({ useResetCountdownClock: () => 0 }))
+
+import { ProviderLetterBadge, ProviderSegment, UsageOverflowChip } from './StatusBarProviderSegment'
+
+const DEFERRED = 'Waiting for credential refresh'
+const RATE_LIMITED = 'Refresh rate limited'
+
+function deferredClaude(): ProviderRateLimits {
+  return {
+    provider: 'claude',
+    session: null,
+    weekly: null,
+    updatedAt: 1,
+    error: 'Usage refresh deferred by a live Claude session',
+    status: 'error',
+    usageMetadata: { failureKind: 'deferred-by-live-session' }
+  }
+}
+
+// A 429 on the usage read keeps the previous sample on screen.
+function rateLimitedClaudeWithSample(): ProviderRateLimits {
+  return {
+    provider: 'claude',
+    session: { usedPercent: 41, windowMinutes: 300, resetsAt: null, resetDescription: null },
+    weekly: null,
+    updatedAt: 1,
+    error: 'HTTP 429 from the Claude usage endpoint',
+    status: 'error',
+    usageMetadata: { failureKind: 'rate-limited' }
+  }
+}
+
+function healthyCodex(usedPercent: number): ProviderRateLimits {
+  return {
+    provider: 'codex',
+    session: { usedPercent, windowMinutes: 300, resetsAt: null, resetDescription: null },
+    weekly: null,
+    updatedAt: 1,
+    error: null,
+    status: 'ok'
+  }
+}
+
+const badge = { ordinal: 1, email: 'a@example.com', isActive: true }
+
+function parse(markup: string): HTMLElement {
+  return new DOMParser().parseFromString(markup, 'text/html').body
+}
+
+function renderSegment(p: ProviderRateLimits, compact: boolean): HTMLElement {
+  return parse(
+    renderToStaticMarkup(<ProviderSegment p={p} compact={compact} display="used" badge={badge} />)
+  )
+}
+
+describe('failing lane mark', () => {
+  it('keeps the reason on hover of the mark once compact drops the label', () => {
+    const host = renderSegment(deferredClaude(), true)
+
+    const mark = host.querySelector('[role="img"]')
+    expect(mark?.getAttribute('aria-label')).toBe(DEFERRED)
+    expect(mark?.getAttribute('title')).toBe(DEFERRED)
+    expect(mark?.querySelector('svg')).not.toBeNull()
+    expect(host.textContent).not.toContain(DEFERRED)
+  })
+
+  it('spells the reason out in a bounded label, not twice, while the bar has room', () => {
+    const host = renderSegment(deferredClaude(), false)
+
+    const titled = host.querySelectorAll(`[title="${DEFERRED}"]`)
+    expect(titled).toHaveLength(1)
+    expect(titled[0]?.textContent).toBe(DEFERRED)
+    expect(titled[0]?.className).toContain('max-w-[72px]')
+    expect(titled[0]?.className).toContain('truncate')
+    expect(host.querySelector('[role="img"]')).toBeNull()
+  })
+
+  it.each([true, false])(
+    'names the reason on the mark of a lane still showing its retained sample (compact: %s)',
+    (compact) => {
+      const host = renderSegment(rateLimitedClaudeWithSample(), compact)
+
+      expect(host.textContent).toContain('41%')
+      const mark = host.querySelector('[role="img"]')
+      expect(mark?.getAttribute('title')).toBe(RATE_LIMITED)
+      expect(mark?.getAttribute('aria-label')).toBe(RATE_LIMITED)
+    }
+  )
+
+  // Why: the store overlays a retry as `fetching` on the failed state without clearing its error.
+  it.each([true, false])(
+    'keeps a no-sample lane failing while its retry runs (compact: %s)',
+    (compact) => {
+      const host = renderSegment({ ...deferredClaude(), status: 'fetching' }, compact)
+
+      expect(host.querySelector(`[title="${DEFERRED}"]`)).not.toBeNull()
+      expect(host.textContent).not.toContain('···')
+    }
+  )
+
+  it('still shows a first fetch with no failure as loading', () => {
+    const host = renderSegment({ ...deferredClaude(), status: 'fetching', error: null }, true)
+
+    expect(host.textContent).toContain('···')
+    expect(host.querySelector('[role="img"]')).toBeNull()
+  })
+
+  it('leaves a healthy lane unmarked', () => {
+    const host = renderSegment(healthyCodex(34), true)
+
+    expect(host.querySelector('[role="img"]')).toBeNull()
+    expect(host.querySelector('svg.lucide-triangle-alert')).toBeNull()
+  })
+})
+
+describe('letter badge of a failing lane', () => {
+  function renderBadge(p: ProviderRateLimits): HTMLElement {
+    return parse(renderToStaticMarkup(<ProviderLetterBadge p={p} />))
+  }
+
+  it.each([
+    ['without a sample', deferredClaude(), DEFERRED],
+    ['with a retained sample', rateLimitedClaudeWithSample(), RATE_LIMITED],
+    ['while its retry runs', { ...deferredClaude(), status: 'fetching' as const }, DEFERRED]
+  ])('names the reason on hover and to assistive technology (%s)', (_state, p, reason) => {
+    const host = renderBadge(p)
+
+    expect(host.querySelector(`[title="${reason}"]`)?.textContent).toBe('C')
+    expect(host.querySelector('[role="img"]')?.getAttribute('aria-label')).toBe(reason)
+  })
+
+  it('stays silent for a healthy lane', () => {
+    const host = renderBadge(healthyCodex(34))
+
+    expect(host.querySelector('[title]')).toBeNull()
+    expect(host.querySelector('[role="img"]')).toBeNull()
+  })
+})
+
+describe('"+N" chip hiding a failing lane', () => {
+  function renderChip(hidden: ProviderRateLimits[]): HTMLElement {
+    const host = parse(
+      renderToStaticMarkup(
+        <UsageOverflowChip
+          hidden={hidden.map((limits, index) => ({
+            limits,
+            badge: limits.provider === 'claude' ? { ...badge, ordinal: index + 1 } : null
+          }))}
+          display="used"
+        />
+      )
+    )
+    return host.querySelector<HTMLElement>('[data-usage-more]')!
+  }
+
+  it('takes the warning tone and names each hidden failure on hover', () => {
+    const chip = renderChip([healthyCodex(12), deferredClaude(), rateLimitedClaudeWithSample()])
+
+    expect(chip.dataset.tone).toBe('warning')
+    expect(chip.textContent).toBe('+3')
+    expect(chip.title).toBe(
+      `Also: Codex 12% used, Claude a@example.com · ${DEFERRED}, Claude a@example.com 41% used · ${RATE_LIMITED}`
+    )
+  })
+
+  it('stays calm while it hides only healthy lanes', () => {
+    const chip = renderChip([healthyCodex(12), healthyCodex(20)])
+
+    expect(chip.dataset.tone).toBe('normal')
+    expect(chip.title).toBe('Also: Codex 12% used, Codex 20% used')
+  })
+
+  it('keeps an urgent hidden lane urgent', () => {
+    const chip = renderChip([deferredClaude(), healthyCodex(97)])
+
+    expect(chip.dataset.tone).toBe('urgent')
+  })
+})
